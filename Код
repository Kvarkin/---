    <script>
        // --- WEB AUDIO API AUDIO ENGINE ---
        let audioCtx = null;
        let soundEnabled = true;

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function playClickSound() {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(140, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.03);
                gain.gain.setValueAtTime(0.12, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, ctx.currentTime + 0.03);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.03);
            } catch (e) {}
        }

        function playStampSound() {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(90, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(25, ctx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.4, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, ctx.currentTime + 0.15);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.15);
            } catch (e) {}
        }

        function playTerminalBeep() {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(800, ctx.currentTime);
                gain.gain.setValueAtTime(0.05, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.001, ctx.currentTime + 0.05);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.05);
            } catch (e) {}
        }

        function playAlarmSound() {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioContext();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(440, ctx.currentTime);
                osc.frequency.linearRampToValueAtTime(880, ctx.currentTime + 0.3);
                osc.frequency.linearRampToValueAtTime(440, ctx.currentTime + 0.6);
                gain.gain.setValueAtTime(0.2, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0.01, ctx.currentTime + 0.6);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.6);
            } catch (e) {}
        }

        function toggleAudio() {
            soundEnabled = !soundEnabled;
            const btn1 = document.getElementById('sound-btn');
            const btn2 = document.getElementById('auth-sound-btn');
            const txt = soundEnabled ? 'ЗВУК: ВКЛ' : 'ЗВУК: ВЫКЛ';
            if (btn1) btn1.innerText = txt;
            if (btn2) btn2.innerText = txt;
            if (soundEnabled) playClickSound();
        }

        // --- STATE MANAGEMENT ---
        let currentUser = {
            id: 'Агент-42',
            clearance: 'gamma',
            password: ''
        };

        let currentTheme = 'paper';
        let currentDocKey = 'sitom';
        let activeCategoryFilter = 'all';

        let clearanceLevels = {
            'omega': 1,
            'lambda': 2,
            'gamma': 3,
            'beta': 4,
            'alpha': 5
        };

        let clearanceDisplayNames = {
            'omega': 'ОМЕГА [Спецконтингент / Расходник]',
            'lambda': 'ЛЯМБДА [Полевой агент / Дознаватель]',
            'gamma': 'ГАММА [Начальник направления]',
            'beta': 'БЕТА [Заместитель директора]',
            'alpha': 'АЛЬФА [Директор / Высший совет]'
        };

        // --- INITIAL DEFAULT DOCUMENTS DATABASE ---
        const defaultDocuments = {
            'sitom': {
                id: 'ЦИРКУЛЯР № 43',
                title: "ЦИРКУЛЯР № 43/С-А",
                subtitle: "О выявлении признаков материальных отклонений в сводках милиции",
                clearance: "gamma",
                category: "Нормативные акты",
                stamp: "АРХИВ НКВД СССР",
                content: `В связи с участившимися случаями привлечения внимания гражданского населения к неизученным физическим и биологическим явлениям, приказываю усилить бдительность при первичном анализе входящей документации Главного управления милиции.

Любая огласка фактов существования материальных отклонений (МО) является [[идеологической диверсией|3]], подрывающей основы научного материализма. Задача внедренных архивистов — оперативно выявлять в потоке бытовых сводок истинные МО.

1. Биологические и медицинские маркеры:
- Нетипичные посмертные изменения: «тело обратилось в пыль/слизь», «отсутствие внутренних органов без следов хирургии».
- Нарушение законов анатомии: «субъект перенес воздействие открытого огня без ожогов».
- Массовый психоз, сопровождающийся одинаковыми галлюцинациями у изолированных лиц.

2. Протокол действий (Система «Сито»):
При обнаружении признаков МО сотрудник Спецархива обязан немедленно изъять оригинал дела из документооборота. В картотеку территориального отдела УГРО помещается фиктивная резолюция: [[«Дело передано в Транспортный отдел НКВД для спецпроверки»|3]].`
            },
            'tabula': {
                id: 'ПРОТОКОЛ-ТАБУЛА',
                title: "ПРОТОКОЛ «ТАБУЛА РАСА»",
                subtitle: "Инструкция по химико-неврологическому вытеснению памяти",
                clearance: "lambda",
                category: "Нормативные акты",
                stamp: "МЕДОТДЕЛ НКВД",
                content: `Метод предназначен для ликвидации следов кратковременной памяти у свидетелей «Несущественных» и «Особых» материальных отклонений без применения летальных средств.

Технологическая база:
1. Фармакология (Агенты группы «С»): Внутривенное введение препарата блокирует закрепление кратковременной памяти в долговременную.
2. Физическое воздействие (Аппарат «Луч-4»): Направленный электромагнитный импульс в височные доли обнуляет синаптическую активность.

Порядок проведения:
- Оцепление района силами внутренней охраны [[[Кси]|2]].
- Введение препарата «С-2» и воздействие аппаратом «Луч-4» под видом санитарной обработки.
- Внедрение замещающего воспоминания: [[«Вы отравились угарным газом на производстве»|2]].`
            },
            'mo042': {
                id: 'МО-042',
                title: "МО-042 «Агрегат К-7»",
                subtitle: "Объект-Краснознаменск-16, Цех №4",
                clearance: "gamma",
                category: "Материальные отклонения",
                stamp: "В ПРОИЗВОДСТВЕ",
                content: `1. Описание: Металлообрабатывающий станок неизвестной серии. Станина выполнена из неизученной формы сверхплотного углерода. Источник питания отсутствует.

2. Аномальные свойства: Способен обрабатывать любые материалы с нулевым износом и абсолютной микронной точностью. Детали обладают прочностью на 400% выше расчетной.

3. Протокол эксплуатации: Движущей силой станка является биологическая энергия центральной нервной системы. В качестве привода используются исключительно заключенные контингента [[категории Омега|1]].

Резолюция: Нервная система субъекта полностью выгорает за 72-96 часов непрерывной работы. Запрещено использовать лиц с высшим образованием во избежание несанкционированных аномальных свойств деталей.`
            },
            'mo102': {
                id: 'МО-102',
                title: "МО-102 «Рой»",
                subtitle: "Зона отчуждения «Сектор-8», Красноярский край",
                clearance: "gamma",
                category: "Материальные отклонения",
                stamp: "УГРОЗА ЛИКВИДАЦИИ",
                content: `1. Описание: Популяция гигантских ос (длина до 40 см, размах крыльев до 65 см). Хитин выдерживает попадание мелкокалиберных пуль с 15 метров.

2. Репродуктивный цикл: Парализуют жертву нейротоксином и внедряют от 10 до 30 личинок в мягкие ткани. Полный цикл созревания личинок — 36 часов.

3. Попытка истребления (1937 г.): Применение огнесмесей и химикатов привело к [[взрывному репродуктивному скачку матки|3]] и гибели 14 бойцов охраны.

4. Режим содержания: Двойной периметр с вышками и роторными огнеметами. Доступ разрешен только смертникам категории [[Омега|1]] для поддержания стационарного состояния роя.`
            },
            'mo001': {
                id: 'МО-001',
                title: "МО-001 «Король в жёлтом»",
                subtitle: "Иномирье (Прямой доступ заблокирован)",
                clearance: "alpha",
                category: "Материальные отклонения",
                stamp: "ГРИФ: ТОЛЬКО АЛЬФА",
                content: `1. Природа объекта: Доминирующая сущность Иномирья. Гуманоидная фигура в изношенном жёлтом плаще с бледной фарфоровой маской. Стремится к тотальному ментальному контролю разумных существ.

2. Механизм экспансии: Не имея возможности проникнуть в наш мир из-за [[материалистического купола советской идеологии|5]], объект использует информационные векторы (МО-234 и МО-056).

Особое указание директориата: Любое упоминание сущности в печати или искусстве карается немедленной изоляцией автора в спецпсихбольнице. Атеизм и научный материализм признаны государственным протоколом сдерживания МО-001.`
            },
            'incident_theater': {
                id: 'ИНЦИДЕНТ-44',
                title: "РАПОРТ ГРУППЫ «ТЕТА»",
                subtitle: "Отчет о зачистке Ленинградского Академического театра драмы",
                clearance: "gamma",
                category: "Журнал инцидентов",
                stamp: "УОР НКВД",
                content: `1. Изоляция: Сигнал о проявлении МО-234 поступил в 23:18. Здание театра заблокировано в 23:40 под видом учений гражданской обороны.

2. Зачистка эпицентра: В пошивочно-декорационном цехе обнаружен холст с символом МО-234. Наброшено свинцовое покрывало «Завеса-3».

Потери личного состава: Красноармеец Власов Т.Д. зафиксировал объект прямым взглядом. Зафиксирован приступ фокальной эпилепсии. Боец изолирован и направлен на Объект-44.

3. Обработка свидетелей: 11 гражданских лиц обработаны аппаратом «Луч-4» и препаратом «С-2». Сформирована ложная память о [[локальном возгорании проводки|3]].`
            }
        };

        let documents = {};

        // --- LOCAL STORAGE ENGINE ---
        function loadDatabaseFromStorage() {
            const storedDocs = localStorage.getItem('specxran_docs');
            if (storedDocs) {
                try {
                    documents = JSON.parse(storedDocs);
                } catch (e) {
                    documents = { ...defaultDocuments };
                }
            } else {
                documents = { ...defaultDocuments };
            }

            const storedClr = localStorage.getItem('specxran_clearances');
            if (storedClr) {
                try {
                    clearanceLevels = JSON.parse(storedClr);
                } catch (e) {}
            }

            const storedNames = localStorage.getItem('specxran_clr_names');
            if (storedNames) {
                try {
                    clearanceDisplayNames = JSON.parse(storedNames);
                } catch (e) {}
            }

            populateClearanceSelects();
        }

        function saveDatabaseToStorage() {
            localStorage.setItem('specxran_docs', JSON.stringify(documents));
            localStorage.setItem('specxran_clearances', JSON.stringify(clearanceLevels));
            localStorage.setItem('specxran_clr_names', JSON.stringify(clearanceDisplayNames));
        }

        function resetDatabase() {
            playStampSound();
            if (confirm("Вы действительно хотите сбросить архив к заводским настройкам? Все ваши изменения будут удалены.")) {
                localStorage.removeItem('specxran_docs');
                localStorage.removeItem('specxran_clearances');
                localStorage.removeItem('specxran_clr_names');
                documents = { ...defaultDocuments };
                clearanceLevels = { 'omega': 1, 'lambda': 2, 'gamma': 3, 'beta': 4, 'alpha': 5 };
                clearanceDisplayNames = {
                    'omega': 'ОМЕГА [Спецконтингент / Расходник]',
                    'lambda': 'ЛЯМБДА [Полевой агент / Дознаватель]',
                    'gamma': 'ГАММА [Начальник направления]',
                    'beta': 'БЕТА [Заместитель директора]',
                    'alpha': 'АЛЬФА [Директор / Высший совет]'
                };
                loadDatabaseFromStorage();
                renderSidebarNav();
                loadDocument('sitom');
                showModal('СБРОС ВЫПОЛНЕН', 'База данных восстановлена до исходного состояния.');
            }
        }

        function populateClearanceSelects() {
            const selects = [document.getElementById('clearance-select'), document.getElementById('doc-input-clearance')];
            selects.forEach(select => {
                if (!select) return;
                const currentVal = select.value;
                select.innerHTML = '';
                Object.keys(clearanceLevels).forEach(key => {
                    const opt = document.createElement('option');
                    opt.value = key;
                    opt.innerText = clearanceDisplayNames[key] || key.toUpperCase();
                    if (key === currentVal) opt.selected = true;
                    select.appendChild(opt);
                });
                if (!select.value && Object.keys(clearanceLevels).length > 0) {
                    select.value = Object.keys(clearanceLevels)[0];
                }
            });
        }

        // --- TEXT PARSER FOR REDACTED TAGS ---
        function parseDocumentContent(rawText) {
            return rawText.replace(/\[\[(.*?)\Vert{}(.*?)\]\]/g, (match, text, level) => {
                let lvlKeyOrNum = level.trim();
                let reqLevel = 2;
                if (!isNaN(lvlKeyOrNum)) {
                    reqLevel = parseInt(lvlKeyOrNum);
                } else {
                    reqLevel = clearanceLevels[lvlKeyOrNum] || 2;
                }
                return `<span class="redacted" onclick="revealRedaction(this, ${reqLevel})">${text}</span>`;
            }).replace(/\n/g, '<br>');
        }

        // --- AUTHORIZATION & SHIFT CODES ---
        function authorizeUser() {
            playClickSound();
            const select = document.getElementById('clearance-select');
            const agentInput = document.getElementById('agent-id');
            const secretInput = document.getElementById('secret-code');
            
            let clearance = select.value;
            const secret = secretInput.value.trim().toUpperCase();

            if (secret === 'LUBYANKA' || secret === 'ALPHA-99') {
                clearance = 'alpha';
                showModal('ШИФР ПРИНЯТ', 'Активирован высший уровень доступа [АЛЬФА] по директиве Наркома.');
            } else if (secret === 'BETA-1937') {
                clearance = 'beta';
                showModal('ШИФР ПРИНЯТ', 'Активирован уровень допуска [БЕТА].');
            }

            currentUser.clearance = clearance;
            currentUser.id = agentInput.value.trim() || 'Агент-УК';

            document.getElementById('display-clearance').innerText = clearance.toUpperCase();
            document.getElementById('display-user').innerText = currentUser.id;

            select.value = clearance;

            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('main-app').classList.remove('hidden');

            playStampSound();
            renderSidebarNav();
            loadDocument(Object.keys(documents)[0] || 'sitom');
        }

        function lockSystem() {
            playClickSound();
            document.getElementById('main-app').classList.add('hidden');
            document.getElementById('auth-screen').classList.remove('hidden');
        }

        // --- SIDEBAR NAVIGATION RENDERER ---
        function renderSidebarNav() {
            const listContainer = document.getElementById('document-nav-list');
            listContainer.innerHTML = '';

            let count = 0;
            const keys = Object.keys(documents);

            keys.forEach(key => {
                const doc = documents[key];

                if (activeCategoryFilter !== 'all') {
                    if (activeCategoryFilter === 'Пользовательские' && !doc.isCustom) return;
                    if (activeCategoryFilter !== 'Пользовательские' && doc.category !== activeCategoryFilter) return;
                }

                count++;

                const btn = document.createElement('button');
                btn.setAttribute('data-key', key);
                btn.onclick = () => loadDocument(key);
                btn.className = `nav-btn w-full text-left px-3 py-2 hover:bg-zinc-800 text-zinc-300 rounded transition-colors flex items-center justify-between group ${key === currentDocKey ? 'bg-zinc-800 border-l-4 border-red-600' : ''}`;

                let badgeColor = 'text-zinc-500';
                if (doc.clearance === 'alpha') badgeColor = 'text-red-600 font-bold';
                else if (doc.clearance === 'beta') badgeColor = 'text-red-400';
                else if (doc.clearance === 'gamma') badgeColor = 'text-amber-500';

                btn.innerHTML = `
                    <div class="truncate pr-2">
                        <div class="truncate">${doc.title}</div>
                        ${doc.isCustom ? '<span class="text-[9px] text-emerald-400 font-terminal">[Свое]</span>' : ''}
                    </div>
                    <span class="text-[10px] ${badgeColor} uppercase">${doc.clearance}</span>
                `;

                listContainer.appendChild(btn);
            });

            document.getElementById('doc-count').innerText = `${count} дел`;
        }

        // --- DOCUMENT VIEWER ---
        function loadDocument(docKey) {
            playClickSound();
            currentDocKey = docKey;
            const doc = documents[docKey];
            if (!doc) return;

            if (doc.clearance === 'alpha' || docKey === 'mo102') {
                playAlarmSound();
                document.body.classList.add('alarm-active');
                setTimeout(() => document.body.classList.remove('alarm-active'), 1200);
            }

            renderSidebarNav();

            const userLevelNum = clearanceLevels[currentUser.clearance] || 1;
            const requiredLevelNum = clearanceLevels[doc.clearance] || 1;

            const container = document.getElementById('doc-container');

            if (userLevelNum < requiredLevelNum) {
                container.innerHTML = `
                    <div class="flex flex-col items-center justify-center h-full my-auto text-center py-20">
                        <div class="soviet-stamp text-red-800 text-lg mb-4">ДОСТУП ЗАПРЕЩЕН</div>
                        <h2 class="font-typewriter text-2xl font-bold mb-2">НЕДОСТАТОЧНЫЙ УРОВЕНЬ ДОПУСКА</h2>
                        <p class="font-typewriter text-sm max-w-md">
                            Для чтения документа <strong>«${doc.title}»</strong> требуется допуск не ниже <span class="uppercase font-bold text-red-900">${doc.clearance}</span>. Ваш текущий уровень: <span class="uppercase font-bold">${currentUser.clearance}</span>.
                        </p>
                        <p class="font-terminal text-xs mt-6 opacity-70">Попытка несанкционированного доступа зафиксирована контрразведкой [Кси].</p>
                    </div>
                `;
                return;
            }

            const formattedContent = parseDocumentContent(doc.content);

            container.innerHTML = `
                <div class="flex justify-between items-start mb-6 border-b-2 border-zinc-800 pb-4">
                    <div>
                        <span class="font-typewriter text-xs text-zinc-600 uppercase tracking-widest">${doc.category || 'ДОКУМЕНТ СПЕЦХРАНА'}</span>
                        <h2 class="font-typewriter text-2xl font-bold mt-1">${doc.title}</h2>
                        <p class="font-terminal text-xs text-zinc-700">${doc.subtitle || ''}</p>
                    </div>
                    <div class="flex flex-col items-end gap-2">
                        <div class="soviet-stamp text-xs">${doc.stamp || 'АРХИВ НКВД'}</div>
                        <div class="flex gap-1 text-[11px] font-terminal mt-2">
                            <button onclick="editAnyDoc('${docKey}')" class="bg-amber-900 hover:bg-amber-800 text-white px-2 py-0.5 rounded shadow">Редактировать</button>
                            ${doc.isCustom ? `<button onclick="deleteCustomDoc('${docKey}')" class="bg-red-900 hover:bg-red-800 text-white px-2 py-0.5 rounded shadow">Удалить</button>` : ''}
                        </div>
                    </div>
                </div>

                <div class="font-document text-sm leading-relaxed space-y-4">
                    ${formattedContent}
                </div>
            `;
        }

        // --- REDACTION REVEAL ---
        function revealRedaction(element, requiredLevelNum = 2) {
            playClickSound();
            const userLevelNum = clearanceLevels[currentUser.clearance] || 1;
            
            if (userLevelNum >= requiredLevelNum) {
                element.classList.toggle('revealed');
            } else {
                showModal('ОШИБКА ДЕШИФРОВКИ', 'Ваш уровень допуска не позволяет расшифровать данный фрагмент данных.');
            }
        }

        // --- CREATE / EDIT CUSTOM DOCUMENT LOGIC ---
        function openCreateDocModal() {
            playClickSound();
            document.getElementById('edit-doc-key').value = '';
            document.getElementById('create-modal-title').innerText = 'СОЗДАНИЕ НОВОГО ДЕЛА СПЕЦХРАНА';
            document.getElementById('create-doc-form').reset();
            populateClearanceSelects();
            document.getElementById('create-doc-modal').classList.remove('hidden');
        }

        function closeCreateDocModal() {
            playClickSound();
            document.getElementById('create-doc-modal').classList.add('hidden');
        }

        function insertRedactedTag() {
            playClickSound();
            const textarea = document.getElementById('doc-input-content');
            const start = textarea.selectionStart;
            const end = textarea.selectionEnd;
            const selectedText = textarea.value.substring(start, end) || 'Секретная информация';
            const tag = `[[${selectedText}|2]]`;
            textarea.value = textarea.value.substring(0, start) + tag + textarea.value.substring(end);
        }

        function saveCustomDocument(e) {
            e.preventDefault();
            playStampSound();

            const editKey = document.getElementById('edit-doc-key').value;
            const id = document.getElementById('doc-input-id').value.trim();
            const title = document.getElementById('doc-input-title').value.trim();
            const subtitle = document.getElementById('doc-input-subtitle').value.trim();
            const category = document.getElementById('doc-input-category').value;
            const clearance = document.getElementById('doc-input-clearance').value;
            const stamp = document.getElementById('doc-input-stamp').value.trim() || 'СЕКРЕТНО';
            const content = document.getElementById('doc-input-content').value;

            const docKey = editKey || ('custom_' + Date.now());

            documents[docKey] = {
                id: id,
                title: title,
                subtitle: subtitle,
                clearance: clearance,
                category: category,
                stamp: stamp,
                isCustom: editKey ? documents[editKey].isCustom : true,
                content: content
            };

            saveDatabaseToStorage();
            closeCreateDocModal();
            renderSidebarNav();
            loadDocument(docKey);

            showModal('ДЕЛО ЗАРЕГИСТРИРОВАНО', `Документ «${title}» успешно сохранен в реестре Спецхрана-А.`);
        }

        function editAnyDoc(key) {
            playClickSound();
            const doc = documents[key];
            if (!doc) return;

            populateClearanceSelects();
            document.getElementById('edit-doc-key').value = key;
            document.getElementById('create-modal-title').innerText = 'РЕДАКТИРОВАНИЕ ДЕЛА: ' + doc.id;
            document.getElementById('doc-input-id').value = doc.id;
            document.getElementById('doc-input-title').value = doc.title;
            document.getElementById('doc-input-subtitle').value = doc.subtitle || '';
            document.getElementById('doc-input-category').value = doc.category || 'Материальные отклонения';
            document.getElementById('doc-input-clearance').value = doc.clearance;
            document.getElementById('doc-input-stamp').value = doc.stamp || 'АРХИВ НКВД';
            document.getElementById('doc-input-content').value = doc.content;

            document.getElementById('create-doc-modal').classList.remove('hidden');
        }

        function deleteCustomDoc(key) {
            playClickSound();
            if (confirm(`Вы уверены, что хотите уничтожить дело «${documents[key].title}»?`)) {
                delete documents[key];
                saveDatabaseToStorage();
                renderSidebarNav();
                loadDocument(Object.keys(documents)[0] || 'sitom');
                showModal('ДЕЛО УНИЧТОЖЕНО', 'Запись и материалы дела удалены из архива.');
            }
        }

        // --- CLEARANCE MANAGEMENT LOGIC ---
        function openClearanceModal() {
            playClickSound();
            renderClearanceList();
            document.getElementById('clearance-modal').classList.remove('hidden');
        }

        function closeClearanceModal() {
            playClickSound();
            document.getElementById('clearance-modal').classList.add('hidden');
        }

        function renderClearanceList() {
            const container = document.getElementById('clearance-list-container');
            container.innerHTML = '';
            Object.keys(clearanceLevels).forEach(key => {
                const row = document.createElement('div');
                row.className = 'flex justify-between items-center bg-white p-2 border border-zinc-300 rounded';
                row.innerHTML = `
                    <div>
                        <strong>[${key.toUpperCase()}]</strong> ${clearanceDisplayNames[key] || ''} 
                        <span class="text-zinc-500">(Ранг: ${clearanceLevels[key]})</span>
                    </div>
                    ${['omega', 'lambda', 'gamma', 'beta', 'alpha'].includes(key) ? '<span class="text-[10px] text-zinc-400">Базовый</span>' : `<button onclick="deleteClearance('${key}')" class="text-red-700 font-bold hover:underline">Удалить</button>`}
                `;
                container.appendChild(row);
            });
        }

        function addNewClearance(e) {
            e.preventDefault();
            playStampSound();
            const keyInput = document.getElementById('new-clr-key').value.trim().toLowerCase();
            const levelInput = parseInt(document.getElementById('new-clr-level').value) || 3;
            const nameInput = document.getElementById('new-clr-name').value.trim();

            if (!keyInput || !nameInput) return;

            clearanceLevels[keyInput] = levelInput;
            clearanceDisplayNames[keyInput] = nameInput;

            saveDatabaseToStorage();
            populateClearanceSelects();
            renderClearanceList();
            e.target.reset();
            showModal('ДОПУСК ДОБАВЛЕН', `Уровень допуска «${nameInput}» успешно активирован в системе.`);
        }

        function deleteClearance(key) {
            playClickSound();
            if (confirm(`Удалить допуск ${key}?`)) {
                delete clearanceLevels[key];
                delete clearanceDisplayNames[key];
                saveDatabaseToStorage();
                populateClearanceSelects();
                renderClearanceList();
            }
        }

        // --- PASSWORD MANAGEMENT LOGIC ---
        function openPasswordModal() {
            playClickSound();
            document.getElementById('pwd-modal-agent').value = currentUser.id;
            document.getElementById('pwd-modal-pass').value = currentUser.password || '';
            document.getElementById('pwd-modal-secret').value = '';
            document.getElementById('password-modal').classList.remove('hidden');
        }

        function closePasswordModal() {
            playClickSound();
            document.getElementById('password-modal').classList.add('hidden');
        }

        function savePasswordSettings(e) {
            e.preventDefault();
            playStampSound();
            const agentName = document.getElementById('pwd-modal-agent').value.trim();
            const pass = document.getElementById('pwd-modal-pass').value;
            const secret = document.getElementById('pwd-modal-secret').value.trim().toUpperCase();

            currentUser.id = agentName || currentUser.id;
            if (pass) currentUser.password = pass;

            if (secret === 'LUBYANKA' || secret === 'ALPHA-99') {
                currentUser.clearance = 'alpha';
            } else if (secret === 'BETA-1937') {
                currentUser.clearance = 'beta';
            }

            document.getElementById('display-user').innerText = currentUser.id;
            document.getElementById('display-clearance').innerText = currentUser.clearance.toUpperCase();

            closePasswordModal();
            showModal('ПАРОЛЬ И НАСТРОЙКИ ОБНОВЛЕНЫ', 'Учетные данные оператора успешно изменены в защищенном реестре.');
        }

        // --- JSON EXPORT AND IMPORT ---
        function exportUserData() {
            playClickSound();
            const exportData = {
                documents: documents,
                clearanceLevels: clearanceLevels,
                clearanceDisplayNames: clearanceDisplayNames
            };
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportData, null, 2));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `specxran_archive_${Date.now()}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importUserData(event) {
            playClickSound();
            const fileReader = new FileReader();
            fileReader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported.documents) {
                        documents = { ...documents, ...imported.documents };
                    } else {
                        documents = { ...documents, ...imported };
                    }
                    if (imported.clearanceLevels) {
                        clearanceLevels = { ...clearanceLevels, ...imported.clearanceLevels };
                    }
                    if (imported.clearanceDisplayNames) {
                        clearanceDisplayNames = { ...clearanceDisplayNames, ...imported.clearanceDisplayNames };
                    }
                    saveDatabaseToStorage();
                    populateClearanceSelects();
                    renderSidebarNav();
                    showModal('ИМПОРТ ЗАВЕРШЕН', 'Пользовательские материалы и допуски загружены в базу Спецхрана.');
                } catch (err) {
                    showModal('ОШИБКА ИМПОРТА', 'Некорректный формат JSON файла.');
                }
            };
            fileReader.readAsText(event.target.files[0]);
        }

        // --- CATEGORY AND SEARCH FILTERS ---
        function filterCategory(cat) {
            playClickSound();
            activeCategoryFilter = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => btn.classList.remove('bg-red-800', 'text-white'));
            renderSidebarNav();
        }

        function filterDocuments(query) {
            playClickSound();
            const q = query.toLowerCase().trim();
            const buttons = document.querySelectorAll('#document-nav-list button');

            buttons.forEach(btn => {
                const text = btn.innerText.toLowerCase();
                if (text.includes(q)) {
                    btn.style.display = 'flex';
                } else {
                    btn.style.display = 'none';
                }
            });
        }

        // --- ANOMALY SCANNER MODULE ---
        function openScannerModal() {
            playTerminalBeep();
            const select = document.getElementById('scanner-doc-select');
            select.innerHTML = '';

            Object.keys(documents).forEach(key => {
                const opt = document.createElement('option');
                opt.value = key;
                opt.innerText = `${documents[key].title} (${documents[key].category})`;
                select.appendChild(opt);
            });

            document.getElementById('scanner-modal').classList.remove('hidden');
        }

        function closeScannerModal() {
            playClickSound();
            document.getElementById('scanner-modal').classList.add('hidden');
        }

        function runAnomalyScan() {
            playTerminalBeep();
            const key = document.getElementById('scanner-doc-select').value;
            const doc = documents[key];
            const out = document.getElementById('scanner-output');

            out.innerHTML = `<span class="text-yellow-400">> Выполняется резонансный анализ объекта «${doc.title}»...</span>`;

            setTimeout(() => {
                const rad = Math.floor(Math.random() * 80 + 10);
                const psi = Math.floor(Math.random() * 95 + 5);
                const danger = doc.clearance === 'alpha' ? 'КРИТИЧЕСКИЙ' : (doc.clearance === 'beta' ? 'ВЫСОКИЙ' : 'УМЕРЕННЫЙ');

                out.innerHTML = `
                    <div class="text-emerald-400 font-bold">> АНАЛИЗ ЗАВЕРШЕН СУБ-ДЕТЕКТОРОМ ВЕКТОР-2:</div>
                    <div class="text-zinc-300">• Уровень пси-излучения: <span class="text-amber-400">${psi} %</span></div>
                    <div class="text-zinc-300">• Радиометрическое отклонение: <span class="text-amber-400">${rad} мкР/ч</span></div>
                    <div class="text-zinc-300">• Индекс аномальной угрозы: <span class="text-red-400 font-bold">${danger}</span></div>
                    <div class="text-zinc-400 text-[11px] mt-2 border-t border-amber-900/50 pt-1">
                        Рекомендация: ${psi > 70 ? 'Требуется свинцовое экранирование класса Завеса-3.' : 'Стационарное хранение в закрытом сейфе.'}
                    </div>
                `;
            }, 800);
        }

        // --- TERMINAL COMMAND PROCESSOR ---
        function openTerminalModal() {
            playTerminalBeep();
            document.getElementById('terminal-modal').classList.remove('hidden');
            document.getElementById('terminal-input').focus();
        }

        function closeTerminalModal() {
            playClickSound();
            document.getElementById('terminal-modal').classList.add('hidden');
        }

        function handleTerminalInput(e) {
            if (e.key === 'Enter') {
                executeCommandFromInput();
            }
        }

        function executeCommandFromInput() {
            playTerminalBeep();
            const input = document.getElementById('terminal-input');
            const cmd = input.value.trim();
            if (!cmd) return;

            appendTerminalOutput(`NKVD@specxran:~# ${cmd}`, 'text-emerald-300');
            processCommand(cmd);
            input.value = '';
        }

        function appendTerminalOutput(text, cssClass = 'text-emerald-400') {
            const output = document.getElementById('terminal-output');
            const div = document.createElement('div');
            div.className = cssClass;
            div.innerHTML = text;
            output.appendChild(div);
            output.scrollTop = output.scrollHeight;
        }

        function processCommand(rawCmd) {
            const parts = rawCmd.split(' ');
            const cmd = parts[0].toLowerCase();
            const arg = parts.slice(1).join(' ');

            switch(cmd) {
                case 'help':
                    appendTerminalOutput(`Доступные команды терминала:
  <span class="text-yellow-400">create</span>             - открыть редактор дел
  <span class="text-yellow-400">clearance</span>          - управление допусками
  <span class="text-yellow-400">scan</span>               - запустить сканер аномалий
  <span class="text-yellow-400">status</span>             - состояние сети Спецхрана-А
  <span class="text-yellow-400">export</span>             - выгрузить архив в JSON
  <span class="text-yellow-400">override [код]</span>     - ввод шифра (LUBYANKA / BETA-1937)
  <span class="text-yellow-400">clear</span>              - очистить консоль`);
                    break;
                case 'create':
                    closeTerminalModal();
                    openCreateDocModal();
                    break;
                case 'clearance':
                    closeTerminalModal();
                    openClearanceModal();
                    break;
                case 'scan':
                    closeTerminalModal();
                    openScannerModal();
                    break;
                case 'export':
                    exportUserData();
                    appendTerminalOutput(`[УСПЕХ] Файл архива сформирован для скачивания.`);
                    break;
                case 'status':
                    appendTerminalOutput(`[ОК] Сеть Спецхрана активна.`);
                    appendTerminalOutput(`[ОК] Модуль «Сито» функционирует.`);
                    break;
                case 'override':
                    if (arg.toUpperCase() === 'LUBYANKA' || arg.toUpperCase() === 'ALPHA-99') {
                        currentUser.clearance = 'alpha';
                        document.getElementById('display-clearance').innerText = 'ALPHA';
                        appendTerminalOutput(`<span class="text-red-500 font-bold">[УСПЕХ] Активирован абсолютный доступ АЛЬФА.</span>`);
                    } else {
                        appendTerminalOutput(`<span class="text-red-600">[ОШИБКА] Неверный секретный код.</span>`);
                    }
                    break;
                case 'clear':
                    document.getElementById('terminal-output').innerHTML = '';
                    break;
                default:
                    appendTerminalOutput(`Неизвестная команда "${cmd}". Введите <span class="text-yellow-400">help</span>.`);
            }
        }

        // --- THEME SWITCHER & UTILS ---
        function toggleTheme() {
            playClickSound();
            const viewer = document.getElementById('viewer-wrapper');
            const docContainer = document.getElementById('doc-container');
            const themeBtn = document.getElementById('theme-btn');

            if (currentTheme === 'paper') {
                currentTheme = 'crt';
                themeBtn.innerText = "ТЕМА: ТЕРМИНАЛ";
                viewer.className = "flex-1 bg-zinc-950 p-6 overflow-y-auto flex justify-center items-start crt-scanlines transition-colors duration-300";
                docContainer.className = "max-w-3xl w-full bg-zinc-950 text-emerald-400 border-2 border-emerald-600 shadow-2xl p-10 crt-bg relative min-h-[780px] flex flex-col terminal-glow transition-all";
            } else {
                currentTheme = 'paper';
                themeBtn.innerText = "ТЕМА: БУМАГА";
                viewer.className = "flex-1 bg-zinc-900 p-6 overflow-y-auto flex justify-center items-start transition-colors duration-300";
                docContainer.className = "max-w-3xl w-full bg-[#f4ecd0] text-zinc-900 border-2 border-zinc-700 shadow-2xl p-10 paper-bg relative min-h-[780px] flex flex-col transition-all";
            }
        }

        function printCurrentDocument() {
            playStampSound();
            const doc = documents[currentDocKey];
            showModal('ВЫПИСКА ИЗ АРХИВА ОФОРМЛЕНА', `Документ «${doc.title}» подготовлен для фельдъегерской доставки. Номер отправления: NKVD-SPEC-${Math.floor(Math.random()*89999 + 10000)}.`);
        }

        function showModal(title, text) {
            playClickSound();
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-text').innerText = text;
            document.getElementById('message-modal').classList.remove('hidden');
        }

        function closeMessageModal() {
            playClickSound();
            document.getElementById('message-modal').classList.add('hidden');
        }

        window.onload = function() {
            loadDatabaseFromStorage();
        };
    </script>
</body>
</html>
